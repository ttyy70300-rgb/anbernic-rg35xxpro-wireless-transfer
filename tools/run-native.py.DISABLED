#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
按原厂契约部署并启动 PocketTransfer

原厂机制（/mnt/vendor/ctrl/dmenu_ln 源码确认）：
    app_scheduling() {
        if $CMD > /dev/null 2>&1; then   # 前台跑 dmenu.bin
            if [ -f "$ACT" ]; then       # ACT=/tmp/.next
                if ! sh $ACT; then ...   # dmenu 退出后执行它
            fi
        fi
    }
    # 外层 loadapp.sh: while [ -f $RunBin ]; do $RunBin; done
    # 所以我们的应用退出后，dmenu 会自动重启，菜单回来。

因此正确启动方式：
    1. 写 /tmp/.next，内容为 "sh /mnt/mmc/Roms/APPS/PocketTransfer.sh"
    2. 杀掉 dmenu.bin（模拟用户在菜单里选中并退出）
    3. dmenu_ln 检测到 dmenu 退出，执行 /tmp/.next
    4. 我们的应用接管 framebuffer

用法:
  python tools/run-native.py --host 192.168.3.25          # 部署+启动
  python tools/run-native.py --host 192.168.3.25 --log    # 只看日志
  python tools/run-native.py --host 192.168.3.25 --stop   # 停掉应用
"""
import argparse
import os
import posixpath
import sys
import time

import paramiko

USER, PWD = "root", "root"
APPS = "/mnt/mmc/Roms/APPS"
APPNAME = "PocketTransfer"
SH_PATH = f"{APPS}/{APPNAME}.sh"
NEXT = "/tmp/.next"


def fix_lf(path):
    with open(path, "rb") as f:
        data = f.read()
    if b"\r\n" in data:
        with open(path, "wb") as f:
            f.write(data.replace(b"\r\n", b"\n"))
        return True
    return False


def sftp_mkdirs(sftp, path):
    cur = ""
    for p in path.strip("/").split("/"):
        cur += "/" + p
        try:
            sftp.stat(cur)
        except IOError:
            sftp.mkdir(cur)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--host", default="192.168.3.25")
    ap.add_argument("--src", default="handheld")
    ap.add_argument("--log", action="store_true")
    ap.add_argument("--stop", action="store_true")
    ap.add_argument("--no-deploy", action="store_true")
    args = ap.parse_args()

    cli = paramiko.SSHClient()
    cli.set_missing_host_key_policy(paramiko.AutoAddPolicy())
    cli.connect(args.host, username=USER, password=PWD, timeout=15,
                look_for_keys=False, allow_agent=False)
    print(f"== {args.host} ==")

    def sh(cmd, t=30):
        _, o, e = cli.exec_command(cmd, timeout=t)
        return (o.read().decode("utf-8", "replace")
                + e.read().decode("utf-8", "replace")).strip()

    if args.stop:
        print(sh("pkill -f '%s/main.py' 2>/dev/null; "
                 "pkill -f '%s.sh' 2>/dev/null; echo stopped" % (APPNAME, APPNAME)))
        cli.close()
        return

    # ---- 部署 ----
    if not args.no_deploy:
        src = os.path.abspath(args.src)
        remote = f"{APPS}/{APPNAME}"
        sftp = cli.open_sftp()
        sftp_mkdirs(sftp, remote)
        n = 0
        for fn in sorted(os.listdir(src)):
            fp = os.path.join(src, fn)
            if not os.path.isfile(fp) or fn == "launcher.sh":
                continue
            if not fn.endswith((".py", ".txt", ".json", ".cfg")):
                continue
            if fix_lf(fp):
                pass
            sftp.put(fp, posixpath.join(remote, fn))
            sftp.chmod(posixpath.join(remote, fn), 0o755)
            n += 1

        # 启动脚本：本地 launcher.sh 放到 APPS 根并改名
        lf = os.path.join(src, "launcher.sh")
        with open(lf, "r", encoding="utf-8") as f:
            text = f.read().replace("\r\n", "\n")
        tmp = os.path.join(src, ".gen.sh")
        with open(tmp, "w", encoding="utf-8", newline="\n") as f:
            f.write(text)
        sftp.put(tmp, SH_PATH)
        sftp.chmod(SH_PATH, 0o755)
        os.remove(tmp)
        sftp.close()
        print(f"已上传 {n} 个文件 + 启动脚本 -> {SH_PATH}")

    # ---- 记录启动前状态 ----
    before = sh("cat /sys/class/graphics/fb0/virtual_size 2>&1; "
                "cat /sys/class/graphics/fb0/bits_per_pixel 2>&1")
    print(f"启动前 fb0: {before.replace(chr(10), ' / ')}")

    # ---- 走原厂契约启动 ----
    # dmenu.bin 内部会扫描 /mnt/mmc/Roms/APPS，选中应用时：
    #   写 /tmp/.next（内容是要执行的命令）→ chmod 777 → 自身退出
    # dmenu_ln 的 app_scheduling() 检测到 dmenu 正常退出后执行 sh /tmp/.next
    #
    # 关键：/tmp/.next 必须在 dmenu 退出【前】写好，且 dmenu 退出码必须为 0
    #       （非 0 会走 else 分支 sleep 30 重试）。
    # 所以这里用 SIGINT（dmenu 绑定的退出信号），并等它自然退出。
    print("\n写入 /tmp/.next 并请求 dmenu 正常退出 ...")
    sh(f"printf 'sh {SH_PATH}\\n' > {NEXT}; chmod 777 {NEXT}; cat {NEXT}")

    # 备份当前 dmenu PID，精确只杀它，避免误伤刚重启的
    pid = sh("pgrep -f 'dmenu.bin' | head -1")
    print(f"dmenu PID = {pid}")
    if pid:
        # SIGUSR1 是原厂关闭 dmenu 的方式，见 /etc/init.d/launcher.sh:45
        sh(f"kill -USR1 {pid} 2>/dev/null; echo 'sent SIGUSR1'")
    else:
        print("!! 找不到 dmenu 进程")

    time.sleep(4)

    # ---- 观察结果 ----
    for i in range(1, 9):
        time.sleep(4)
        st = sh("cat /sys/class/graphics/fb0/virtual_size 2>&1; "
                "cat /sys/class/graphics/fb0/bits_per_pixel 2>&1")
        alive = sh("ps aux | grep -v grep | grep -c 'PocketTransfer/main.py'")
        dmenu = sh("pgrep -f dmenu.bin | head -1")
        print(f"  t+{i*4+4:2d}s  fb0={st.replace(chr(10), '/')}  "
              f"应用={alive}  dmenu={dmenu or '无'}")
        if alive == "0" and i > 2:
            print("  （应用未存活，停止观察）")
            break

    print("\n--- 应用日志 ---")
    print(sh(f"cat {APPS}/{APPNAME}/log.txt 2>&1 | tail -40") or "(空)")

    if args.log:
        print("\n持续跟踪日志 60 秒（按 Ctrl-C 停止）...")
        try:
            for _ in range(12):
                time.sleep(5)
                out = sh(f"tail -6 {APPS}/{APPNAME}/log.txt 2>&1")
                print(f"  [{time.strftime('%H:%M:%S')}] {out}")
        except KeyboardInterrupt:
            print("停止跟踪")

    cli.close()


if __name__ == "__main__":
    main()
